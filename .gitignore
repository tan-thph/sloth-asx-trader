# SQLite database — track main DB, exclude WAL/SHM/backups
*.db-shm
*.db-wal
*.db.bak*
# Pre-restore snapshots written before a WAL-corruption recovery (gotcha #49).
# Needs its own pattern: these are named `<db>.pre-restore-<ts>` and their
# sidecars `<db>.pre-restore-<ts>-shm/-wal` — neither *.db.bak* nor *.db-shm
# / *.db-wal matches them, since the suffix falls after the timestamp.
*.db.pre-restore-*
asx_trader.lock

# Understand-anything index (generated, local only)
.understand-anything/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/

# Raw AI responses cache
ai_responses/

# Environment / secrets
.env
.env.*
key.txt
*.key
secrets.json
ngrok.yml
claude-api.txt
webapp-auth.txt

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Node
node_modules/

# Logs
*.log

# Claude Code agent worktrees (leftover per-agent scratch checkouts)
.claude/worktrees/
