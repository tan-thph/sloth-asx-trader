# ngrok.yml.example — copy to ~/.config/ngrok/ngrok.yml and fill in your values.
# NEVER commit the real file; it contains your authtoken.
#
# Setup:
#   1. ngrok config add-authtoken <your-authtoken>
#      (this writes the authtoken to ~/.config/ngrok/ngrok.yml automatically)
#   2. Reserve a free static domain at https://dashboard.ngrok.com/domains
#   3. Replace <your-reserved-domain> and <your-google-email> below.

version: "3"
agent:
  authtoken: <agent-authtoken-from-dashboard>

endpoints:
  - name: sloth
    url: https://<your-reserved-domain>.ngrok-free.app
    upstream:
      url: 5000
    traffic_policy:
      on_http_request:
        - actions:
            - type: oauth
              config:
                provider: google
                allow_emails:
                  - <your-google-email>

# Fallback: swap the oauth action above for basic-auth if OAuth is fussy on a device:
#   - actions:
#       - type: basic-auth
#         config:
#           credentials:
#             - <username>:<password>
